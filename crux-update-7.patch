+        if (state.warning != null) {
+            Text(
+                text = state.warning,
+                color = look.colors.warning,
+                fontSize = 12.sp * scale,
+                textAlign = TextAlign.End,
+                modifier = Modifier.padding(top = 4.dp)
+            )
+        }
+    }
